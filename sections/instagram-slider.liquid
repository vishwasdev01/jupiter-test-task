<!-- jQuery (Required) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Slick Slider CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>

<!-- Slick Slider JS -->
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
{% style %}
  .insta-slick-slider-{{ section.id }} {
    margin-left: -18px; /* Half of 36px to balance */
    margin-right: -18px;
  }
  .instagram-slider-section.{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .instagram-slider-section.{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }


{% endstyle %}


<div class="instagram-slider-section {{ section.id }}">
    <div class="insta_header">
    {% if section.settings.heading != blank %}
      <h2 class="insta-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="insta-subheading">{{ section.settings.subheading }}</p>
    {% endif %}
</div>
    <div class="insta-slick-slider-{{ section.id }} insta_grid"> 
      {% for block in section.blocks %}
        <div class="insta-slide">
            <div class="insta_images"> {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | img_url: 'master' }}" alt="Instagram image" loading="lazy" width="" height="">
          {% endif %}</div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <div class="insta-btn-wrapper bottom_btn">
        <a href="{{ section.settings.button_link }}" target="_blank" class="insta-btn">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %} 
</div>

<script>
  $(document).ready(function() {
    $('.insta-slick-slider-{{ section.id }}').slick({
      slidesToShow: 4.2,
      slidesToScroll: 1,
      {% comment %} autoplay: true, {% endcomment %}
      {% comment %} autoplaySpeed: 2000, {% endcomment %}
      arrows: true,
      dots: true,
      infinite: true,
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 2.2
          }
        },
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 1.1
          }
        }
      ]
    }); 
  });
</script> 

{% schema %}
{
  "name": "Instagram Slider (Slick)",
  "tag": "section",
  "class": "instagram-slider-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow us on Instagram"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "See our latest posts"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Follow on Instagram"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Instagram Image"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Instagram Slider (Slick)",
      "category": "Custom"
    }
  ]
}
{% endschema %}
