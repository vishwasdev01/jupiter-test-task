<div class="take_the_quiz_section {{ section.id }}">
  <div class="page-width" style="background-color: {{ section.settings.background_color }}">
   {% if section.settings.badge_image != blank %} <div class="take_the_logo">
         <img src="{{ section.settings.badge_image | img_url: 'master' }}" width="" height="">
    </div>{% endif %}
    <div class="take_the_grid">
      <div class="take_the_grid_col-1">
       {% if section.settings.main_image != blank%} <div class="take_it_image">
          <img src="{{ section.settings.main_image | img_url: 'master' }}" width="" height="">
        </div>{% endif %}
      </div>
      <div class="take_the_grid_col-2">
        <div class="take_left_container">
          <div class="take_left_badge">
            {% if section.settings.badge != blank %}
              <p>
                <span class="rounded_badge">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <circle opacity="0.4" cx="7" cy="7" r="7" fill="#303030"/>
                  </svg>
                </span>
                {{ section.settings.badge }}
              </p>
            {% endif %}
          </div>

          <div class="take_the_container">
          {% if section.settings.heading != blank%}<h2>{{ section.settings.heading }}</h2>{% endif %}
           {% if section.settings.paragraph %} <p>{{ section.settings.paragraph }}</p>{%  endif %}
          </div>
          <div class="take_the_bottom_btn">
          {% if section.settings.button_label != blank %}  
            <a href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
          {% endif %}
          </div>


        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Take The Quiz",
  "class": "take-the-quiz",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Badge / Logo"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Title",
      "default": "salon-quality"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your heading here"
    },
    {
      "type": "textarea",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "Your paragraph text here."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "TAKE THE QUIZ"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F3F3E6"
    }
  ],
  "presets": [
    {
      "name": "Take The Quiz"
    }
  ]
}
{% endschema %}
