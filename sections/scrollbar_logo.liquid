{% comment %}
  Section: Auto-Scrolling Logo Carousel
{% endcomment %}

<style>
.logo-carousel-wrapper.{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .logo-carousel-wrapper.{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .logo-carousel-wrapper.{{section.id }} {
    overflow: hidden;
    width: 100%;
    border-bottom: 1px solid #333333;
  }

  .logo-carousel {
    display: flex;
    width: max-content;
    animation: scrollLogos 25s linear infinite;
  }

  .logo-item {
    flex: 0 0 auto;
    padding: 0 40px;
  }

 .logo-item img {
    height: 88px;
    width: 220px;
    object-fit: contain;
    max-width: 100%;
}

  @keyframes scrollLogos {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .logo-item {
      padding: 0 20px;
    }
  }
</style>

<div class="logo-carousel-wrapper {{section.id }}">
  <div class="logo-carousel">
    {% for block in section.blocks %}
    {% if block.settings.logo != blank %}  <div class="logo-item">
        <img src="{{ block.settings.logo | img_url: 'medium' }}" alt="Logo {{ forloop.index }}" width="" height=""  loading="lazy">
      </div>{% endif %}
    {% endfor %}
    {% comment %} Duplicate for seamless scrolling {% endcomment %}
    {% for block in section.blocks %}
      {% if block.settings.logo != blank %} <div class="logo-item">
        <img src="{{ block.settings.logo | img_url: 'medium' }}" alt="Logo {{ forloop.index }}"width="" height=""  loading="lazy">
      </div> {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Logo Carousel",
  "class": "logo_custom_tag",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 20
    }
  ], 
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Scrolling Logo Carousel",
      "category": "Custom"
    }
  ]
}
{% endschema %}
