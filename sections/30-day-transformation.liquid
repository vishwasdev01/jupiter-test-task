{% style %}
.transformation-section.{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .transformation-section.{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

{% endstyle %}
<div class="transformation-section {{ section.id }}">
  <div class="transform_cotaniner">
    <div class="transform_gird">
      <div class="transformation_col"> 
        <div class="transformation-left">
            <div class="transform_left_grid">
            <div class="transfrom_left_col">
          <span>{{ section.settings.label_text }}</span>
          <h2>{{ section.settings.heading_text }}</h2>

          <div class="logo_image_310">
            {% if section.settings.icon_area != blank %}
            <img
              src="{{ section.settings.icon_area | img_url: 'master' }}"
              alt="Hair Transformation Image"
              width=""
              height=""
              loading="lazy" 
            >
          {% endif %}
          </div>
            </div>
            <div class="transfrom_left_col">
          {% if section.settings.left_image != blank %}
            <img
              src="{{ section.settings.left_image | img_url: 'master' }}"
              alt="Hair Transformation Image"
              width=""
              height=""
              loading="lazy"
            >
          {% endif %}
        </div>
    </div>
        </div>
      </div>
      <div class="transformation_col">
        <div class="transformation-right">
            <div class="transform_right_grid">
          {% for block in section.blocks %}
            <div class="transformation-stat">
              {% if block.settings.stat1_percent != blank %}
                <h3>{{ block.settings.stat1_percent }}</h3>
              {% endif %}
              {% if block.settings.stat1_text != blank %}
                <a href="{{ block.settings.url }}">{{ block.settings.stat1_text }} 
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none">
                      <path d="M7 7H17M17 7V17M17 7L7 17" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg></a>
              {% endif %}
            </div>
          {% endfor %}
        </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "30 Day Transformation",
  "settings": [
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label",
      "default": "SALON-QUALITY"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "A 30 day transformation"
    },
    {
      "type": "image_picker",
      "id": "icon_area",
      "label": "Icon/Design (optional)"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "content_block",
      "name": "Content Block",
      "settings": [
        {
          "type": "text",
          "id": "stat1_percent",
          "label": "Stat 1 - Percentage",
          "default": "100%"
        },
        {
          "type": "text",
          "id": "stat1_text",
          "label": "Stat 1 - Text",
          "default": "SAW FEWER FLAKES"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Url"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "30 Day Transformation",
      "category": "Custom"
    }
  ]
}
{% endschema %}
