{% style %}
  .faq_wrapper.{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    border-bottom: 1px solid #333333;
  }
  @media screen and (min-width: 750px) {
    .faq_wrapper.{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
   @media (max-width: 768px) {
    .faq_wrapper.{{ section.id }}.page-width {
        padding: 36px 20px 36px
    }
  }
{% endstyle %}
<div class="faq_wrapper {{ section.id }}"> 
    <div class="page-width container">
        <div class="faq_grid_section">
            <div class="faq_grid_col_1">
                <div class="faq_header">
                    <h2>{{ section.settings.faq_heading }}</h2>
                </div>
            </div>
            <div class="faq_grid_col_2">
                {% for block in section.blocks %}
                <div class="faq_grid_box {% if forloop.first %}active{% endif %}">
                   {% if block.settings.question != blank %}
                   <div class="faq_question">
                        <h3>{{ block.settings.question }}</h3>
                        <span class="plusIcon">+</span>
                        <span class="minusIcon">-</span>
                   </div>
                   {% endif %}
                   {% if block.settings.answer != blank %}
                   <div class="faq_answer" style="{% if forloop.first %}display: block;{% else %}display: none;{% endif %}">
                        <p>{{ block.settings.answer }}</p>
                   </div>
                   {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

{% javascript %}
document.addEventListener('DOMContentLoaded', function () {
  const questions = document.querySelectorAll('.faq_question');

  questions.forEach((question, index) => {
    question.addEventListener('click', function () {
      const currentBox = this.closest('.faq_grid_box');
      const answer = currentBox.querySelector('.faq_answer');

      const isActive = currentBox.classList.contains('active');

      // Close all
      document.querySelectorAll('.faq_grid_box').forEach(box => {
        box.classList.remove('active');
        box.querySelector('.faq_answer').style.display = 'none';
      });

      // If it wasn't active, open it
      if (!isActive) {
        currentBox.classList.add('active');
        answer.style.display = 'block';
      }
    });
  });
});
{% endjavascript %}
 

{% schema %}
{
  "name": "FAQ Section",
  "class": "faq-section",
  "tag": "section",
  "settings": [
    {
        "type": "text",
        "id": "faq_heading",
        "label": "Faq Title",
        "default":"Frequenty Asked Questions"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "FAQ Section",
      "category": "Content" 
    }
  ]
}
{% endschema %}
